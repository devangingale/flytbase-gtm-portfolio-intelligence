# GTM Portfolio Command Center

# Optional: Live API Base URL (leave blank during development to use local fixture)
# VITE_API_BASE=https://api.example.com

# MCP data source (backend)
MCP_TOKEN=
MCP_ENDPOINT=https://flytbase-gtm-hackathon.lovable.app/api/mcp

# NVIDIA NIM (OpenAI-compatible endpoint, backend)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_EXTRACTION_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NIM_SYNTHESIS_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Optional (backend)
# DB_PATH=gtm.db
# SYNC_INTERVAL_SECONDS=300
# PORT=8000
